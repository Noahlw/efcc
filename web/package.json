{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "dev:local": "next build && pnpm db:migrate:local && wrangler dev --port ${EFCC_WORKER_PORT:-8787}",
    "db:migrate:local": "wrangler d1 migrations apply efcc-identity --local",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.worker.json",
    "test": "vitest run",
    "test:components": "vitest run --config vitest.components.config.ts",
    "storybook": "node scripts/storybook-worktree.mjs",
    "storybook:build": "storybook build",
    "storybook:verify-index": "../node_modules/.bin/tsx scripts/verify-storybook-index.ts",
    "test:storybook": "vitest run --config vitest.storybook.config.ts",
    "test:t07:foundation": "vitest run --config vitest.t07.config.ts"
  },
  "dependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "barcode-detector": "3.2.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "lucide-react": "^1.58.0",
    "next": "16.4.2",
    "qrcode": "^1.5.4",
    "radix-ui": "^1.8.1",
    "react": "19.3.1",
    "react-day-picker": "^10.0.2",
    "react-dom": "19.3.1",
    "shadcn": "^4.21.5",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.23.0",
    "@cloudflare/workers-types": "^5.20261016.1",
    "@storybook/addon-a11y": "10.6.2",
    "@storybook/addon-vitest": "10.6.2",
    "@storybook/nextjs-vite": "10.6.2",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/browser": "5.0.5",
    "@vitest/browser-playwright": "4.1.10",
    "@vitest/expect": "4.1.10",
    "@vitest/mocker": "4.1.10",
    "@vitest/pretty-format": "4.1.10",
    "@vitest/runner": "4.1.11",
    "@vitest/snapshot": "4.1.10",
    "@vitest/spy": "4.1.10",
    "@vitest/utils": "4.1.10",
    "jsdom": "^30.1.3",
    "msw": "^2.15.0",
    "msw-storybook-addon": "3.0.3",
    "playwright": "1.64.1",
    "storybook": "10.6.2",
    "typescript": "^5",
    "vitest": "4.1.10",
    "wrangler": "4.151.0"
  },
  "msw": {
    "workerDirectory": [
      ".storybook/public"
    ]
  }
}
