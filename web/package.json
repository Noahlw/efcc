{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "dev:local": "next build && pnpm db:migrate:local && wrangler dev",
    "db:migrate:local": "wrangler d1 migrations apply efcc-identity --local",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.worker.json",
    "test": "vitest run",
    "test:components": "vitest run --config vitest.components.config.ts",
    "storybook": "node scripts/storybook-worktree.mjs",
    "storybook:build": "storybook build",
    "storybook:verify-index": "../node_modules/.bin/tsx scripts/verify-storybook-index.ts",
    "test:storybook": "vitest run --config vitest.storybook.config.ts",
    "test:t07:foundation": "vitest run --config vitest.t07.config.ts"
  },
  "dependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "barcode-detector": "3.2.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.41.0",
    "next": "16.3.4",
    "qrcode": "^1.5.4",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "shadcn": "^4.21.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@cloudflare/workers-types": "^5.20260906.1",
    "@storybook/addon-a11y": "10.6.0",
    "@storybook/addon-vitest": "10.6.0",
    "@storybook/nextjs-vite": "10.6.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/browser": "4.1.10",
    "@vitest/browser-playwright": "4.1.10",
    "@vitest/expect": "4.1.10",
    "@vitest/mocker": "4.1.10",
    "@vitest/pretty-format": "4.1.10",
    "@vitest/runner": "4.1.11",
    "@vitest/snapshot": "4.1.10",
    "@vitest/spy": "4.1.10",
    "@vitest/utils": "4.1.10",
    "jsdom": "^30.0.1",
    "msw": "^2.15.0",
    "msw-storybook-addon": "3.0.0",
    "playwright": "1.63.0",
    "storybook": "10.6.0",
    "typescript": "^5",
    "vitest": "^4.1.10",
    "wrangler": "4.129.0"
  },
  "msw": {
    "workerDirectory": [
      ".storybook/public"
    ]
  }
}
