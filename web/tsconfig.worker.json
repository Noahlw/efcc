{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "types": [
      "@cloudflare/workers-types",
      "node",
      "@cloudflare/vitest-pool-workers/types"
    ],
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "isolatedModules": true,
    "skipLibCheck": true
  },
  "include": [
    "worker.ts",
    "worker.test.ts",
    "lib/auth/**/*.ts"
  ]
}
