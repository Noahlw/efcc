{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "types": [
      "@cloudflare/workers-types",
      "node",
      "@cloudflare/vitest-pool-workers/types"
    ],
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "isolatedModules": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./*"]
    }
  },
  "include": [
    "worker-globals.d.ts",
    "worker.ts",
    "worker.test.ts",
    "lib/attendance.ts",
    "lib/attendance-worker.test.ts",
    "lib/home-handlers.ts",
    "lib/home-worker.test.ts",
    "lib/home-cms-handlers.ts",
    "lib/home-cms-worker.test.ts",
    "lib/auth/**/*.ts",
    "lib/programs/**/*.ts",
    "lib/identity/**/*.ts"
  ],
  "exclude": [
    "lib/programs/program-api.ts",
    "lib/home-api.ts",
    "lib/home-api.test.ts"
  ]
}
