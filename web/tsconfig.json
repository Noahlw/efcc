{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts"
  ],
  "exclude": [
    "node_modules",
    "worker.ts",
    "worker.test.ts",
    "worker.auth.test.ts",
    "lib/auth",
    "lib/identity/d1-schema.test.ts",
    "lib/identity/role-hierarchy.test.ts",
    "lib/identity/seeds.test.ts",
    "lib/identity/role-handlers.test.ts",
    "lib/identity/permission-editor.test.ts",
    "lib/identity/permission-editor-handlers.test.ts",
    "lib/identity/account-access.test.ts",
    "lib/identity/account-access-history.test.ts",
    "lib/identity/account-access-handlers.test.ts",
    "lib/identity/normalized-authority.test.ts",
    "lib/permission-editor-panel.test.tsx",
    "lib/attendance.ts",
    "lib/attendance-worker.test.ts",
    "lib/programs/capabilities.ts",
    "lib/programs/workspace-store.ts",
    "lib/programs/d1-workspace-store.ts",
    "lib/programs/capability-authorizer.ts",
    "lib/programs/department-workspace.ts",
    "lib/programs/program-handlers.ts",
    "lib/programs/programs.test.ts",
    "lib/programs/programs-250.test.ts",
    "lib/programs/hub-directory.test.ts",
    "lib/programs/member-directory.test.ts",
    "lib/programs/account-directory.test.ts",
    "lib/programs/notices-worker.test.ts",
    "lib/service-envelope.ts",
    "lib/home-handlers.ts",
    "lib/home-worker.test.ts",
    "lib/home-cms-handlers.ts",
    "lib/home-cms-worker.test.ts",
    "lib/service-envelope.test.ts"
  ]
}
