{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "efcc-prototype-129",
  "main": "worker.ts",
  // Set to today's date at deploy time.
  "compatibility_date": "2026-08-02",
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    "not_found_handling": "404-page",
  },
  "observability": {
    "enabled": true,
  },
  "vars": {
    // PROTOTYPE (issue #129): overwrite before deploy with the isolated
    // Apps Script versioned deployment's /exec URL (never the production
    // deployment). Prefer `wrangler secret put APPS_SCRIPT_EXEC_URL`
    // for anything beyond a throwaway prototype.
    "APPS_SCRIPT_EXEC_URL": "",
  },
  // D1 identity database (ADR-0020 / AUTH-01 #159). Sole system of record
  // for accounts, credentials, sessions, and registration requests. The
  // database_id is a placeholder - replace with the real D1 database id
  // before `wrangler deploy`. In dev/test the binding is auto-provided by
  // @cloudflare/vitest-pool-workers and migrations are applied by the test
  // setup file (web/test/apply-migrations.ts).
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "efcc-identity",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations",
    },
  ],
  // Rate Limiting binding (ADR-0018 §9). Session-keyed, never IP - the
  // Worker reads X-Efcc-Session-Id or the login body's username and calls
  // env.RPC_RATE_LIMITER.limit({ key }). Limits are per-Cloudflare-location
  // and eventually consistent (a tripwire, not an exact global cap).
  // The namespace_id must be a unique integer for the Cloudflare account;
  // replace 1001 with a real id before `wrangler deploy`. In dev/test the
  // binding is auto-provided by @cloudflare/vitest-pool-workers.
  "ratelimits": [
    {
      "name": "RPC_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 100,
        "period": 60,
      },
    },
  ],
  // AUTH-03 (#161): operator-controlled D1 → Sheets identity-metadata review
  // mirror. The Cron Trigger fires daily at 19:00 UTC = 03:00 Asia/Hong_Kong
  // (UTC+8) the following day. The mirror URL and service secret are set with
  // `wrangler secret put` (never as plaintext vars).
  "triggers": {
    "crons": ["0 19 * * *"],
  },
}
