{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "efcc-prototype-129",
  "main": "worker.ts",
  // Set to today's date at deploy time.
  "compatibility_date": "2026-08-02",
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    "not_found_handling": "404-page",
  },
  "observability": {
    "enabled": true,
  },
  "vars": {},
  "triggers": {
    "crons": ["*/5 * * * *"],
  },
  // D1 identity database (ADR-0020 / AUTH-01 #159). Sole system of record
  // for accounts, credentials, sessions, and registration requests. The
  // database_id is a placeholder - replace with the real D1 database id
  // before `wrangler deploy`. In dev/test the binding is auto-provided by
  // @cloudflare/vitest-pool-workers and migrations are applied by the test
  // setup file (web/test/apply-migrations.ts).
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "efcc-identity",
      "database_id": "ae437eac-c6ef-4835-bfe8-13c61b5cf586",
      "migrations_dir": "migrations",
    },
  ],
  // Rate Limiting binding. Keyed per event for guest check-in on the
  // Attendance surface, never IP. Limits are per-Cloudflare-location
  // and eventually consistent (a tripwire, not an exact global cap).
  // The namespace_id must be a unique integer for the Cloudflare account;
  // replace 1001 with a real id before `wrangler deploy`. In dev/test the
  // binding is auto-provided by @cloudflare/vitest-pool-workers.
  "ratelimits": [
    {
      "name": "RPC_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 100,
        "period": 60,
      },
    },
  ],
}
