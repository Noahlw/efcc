{
  "name": "efcc",
  "version": "0.1.0",
  "private": true,
  "description": "顯恩堂系統 — EFCC Church Management System (TypeScript WebApp)",
  "workspaces": [
    "src/frontend"
  ],
  "scripts": {
    "prepare": "husky",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "format": "prettier --write ."
  },
  "lint-staged": {
    "*": "prettier --ignore-unknown --write"
  },
  "prettier": {
    "useTabs": false,
    "tabWidth": 2,
    "printWidth": 80,
    "singleQuote": false,
    "trailingComma": "es5",
    "semi": true,
    "arrowParens": "always"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^15.4.0",
    "prettier": "^3.6.2"
  }
}
