{
  "name": "efcc",
  "version": "0.1.0",
  "private": true,
  "description": "顯恩堂系統 — EFCC Church Management System (TypeScript WebApp)",
  "type": "module",
  "scripts": {
    "prepare": "husky",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test:gas && npm run test --workspaces --if-present",
    "test:gas": "vitest run tests/gas",
    "e2e:auth": "tsx tests/e2e/auth.ts",
    "test:e2e": "playwright test --config=tests/e2e/playwright.config.ts",
    "build": "npm run build --workspaces --if-present",
    "check": "ultracite check",
    "fix": "ultracite fix"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.4.0",
    "oxfmt": "0.61.0",
    "oxlint": "1.76.0",
    "tsx": "^4.23.1",
    "ultracite": "7.9.4",
    "vitest": "^2.1.9"
  },
  "lint-staged": {
    "*.{js,cjs,mjs,jsx,ts,tsx,cts,mts}": "ultracite fix",
    "*.{json,jsonc,css,scss,html,md}": "oxfmt --write --no-error-on-unmatched-pattern"
  }
}
