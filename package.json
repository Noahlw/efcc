{
  "name": "efcc",
  "version": "0.1.0",
  "private": true,
  "description": "顯恩堂系統 — EFCC Church Management System (TypeScript WebApp)",
  "type": "module",
  "scripts": {
    "prepare": "husky",
    "bootstrap": "pnpm install --frozen-lockfile",
    "install:browsers": "playwright install chromium",
    "dev": "pnpm --filter web dev",
    "dev:local": "pnpm --filter web dev:local",
    "build": "pnpm --filter web build",
    "web:typecheck": "pnpm --filter web typecheck",
    "test:components": "pnpm --filter web test:components",
    "storybook": "pnpm --filter web storybook",
    "storybook:build": "pnpm --filter web storybook:build",
    "storybook:test": "pnpm --filter web test:storybook",
    "storybook:verify-index": "pnpm --filter web storybook:verify-index",
    "storybook:update-worker": "pnpm --filter web exec msw init .storybook/public",
    "db:reset:local": "node scripts/reset-local-d1.mjs",
    "db:seed:local": "tsx tests/e2e/seed-dev-accounts.ts --reset > /tmp/efcc-reset-local.sql && pnpm --filter web exec wrangler d1 execute efcc-identity --local --file=/tmp/efcc-reset-local.sql && tsx tests/e2e/seed-dev-accounts.ts > /tmp/efcc-seed-local.sql && pnpm --filter web exec wrangler d1 execute efcc-identity --local --file=/tmp/efcc-seed-local.sql && pnpm db:seed:disposable",
    "db:seed:disposable": "node --experimental-strip-types tests/e2e/seed-disposable-identity.ts",
    "db:seed:demo": "tsx tests/e2e/seed-demo.ts",
    "verify:identity": "pnpm --filter web exec vitest run --config vitest.config.ts lib/identity/d1-schema.test.ts lib/identity/seeds.test.ts lib/identity/role-hierarchy.test.ts lib/identity/role-handlers.test.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tests/e2e/tsconfig.json",
    "test": "pnpm verify",
    "test:workerd": "pnpm --filter web test",
    "test:programs:contract": "pnpm --filter web exec vitest run --config vitest.config.ts lib/programs/programs-contract.test.ts",
    "test:programs:canary:unit": "vitest run web/scripts/programs-runtime-canary.test.mjs",
    "test:programs:canary": "node web/scripts/programs-runtime-canary.mjs",
    "test:programs:browser": "node web/scripts/run-programs-browser-acceptance.mjs",
    "test:programs:home": "node web/scripts/run-programs-home-acceptance.mjs",
    "test:programs:feed": "node web/scripts/run-programs-home-acceptance.mjs --feed",
    "test:programs:responsive": "node web/scripts/run-programs-responsive-matrix.mjs",
    "test:programs:visual": "playwright test --config=tests/e2e/programs-visual-fidelity.config.ts",
    "test:programs:runners:unit": "vitest run web/scripts/run-programs-browser-acceptance.test.mjs web/scripts/run-programs-home-acceptance.test.mjs web/scripts/run-programs-responsive-matrix.test.mjs",
    "test:programs:promotion": "vitest run scripts/verify-programs.test.ts",
    "test:governance": "vitest run scripts/audit-governance.test.ts",
    "verify:fast": "pnpm typecheck && pnpm --filter web typecheck",
    "verify:programs": "node --experimental-strip-types scripts/verify-programs.ts",
    "verify:governance": "tsx scripts/audit-governance.ts --mode=full",
    "verify:governance:fast": "tsx scripts/audit-governance.ts --mode=fast",
    "verify:governance:affected": "tsx scripts/audit-governance.ts --mode=affected",
    "verify:governance:full": "tsx scripts/audit-governance.ts --mode=full",
    "verify:governance:release": "tsx scripts/audit-governance.ts --mode=release",
    "test:storybook:scope": "vitest run scripts/storybook-affected-scope.test.mjs",
    "verify:storybook:affected": "node scripts/storybook-affected-scope.mjs",
    "verify:precommit": "pnpm verify:fast",
    "verify": "pnpm verify:precommit && pnpm test:storybook:scope && pnpm test:governance && pnpm test:programs:canary:unit && pnpm test:programs:runners:unit && pnpm test:programs:promotion && pnpm test:workerd && pnpm test:components && pnpm verify:governance && pnpm storybook:verify-index && pnpm verify:programs && pnpm test:shell-responsive && pnpm test:shell-geometry && pnpm test:role-hierarchy-geometry",
    "test:shell-responsive": "node scripts/run-shell-responsive.mjs",
    "test:shell-geometry": "playwright test --config=tests/e2e/shell-geometry.config.ts",
    "test:role-hierarchy-geometry": "playwright test --config=tests/e2e/role-hierarchy-geometry.config.ts",
    "test:t08:controls": "playwright test --config=tests/e2e/t08-storybook.config.ts",
    "test:t09:foundations": "playwright test --config=tests/e2e/t09-storybook.config.ts",
    "test:t10:composition": "playwright test --config=tests/e2e/t10-storybook.config.ts",
    "test:t11:storybook": "playwright test --config=tests/e2e/t11-storybook.config.ts",
    "check": "ultracite check",
    "fix": "ultracite fix"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.1.2",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "oxfmt": "0.61.0",
    "oxlint": "1.76.0",
    "tsx": "^4.23.5",
    "typescript": "^5.9.3",
    "ultracite": "7.10.0",
    "vitest": "^4.1.10"
  },
  "lint-staged": {
    "*.{js,cjs,mjs,jsx,ts,tsx,cts,mts}": "oxfmt --write --no-error-on-unmatched-pattern",
    "*.{json,jsonc,css,scss,html,md}": "oxfmt --write --no-error-on-unmatched-pattern"
  },
  "packageManager": "pnpm@11.7.0"
}
