{
  "name": "efcc",
  "version": "0.1.0",
  "private": true,
  "description": "顯恩堂系統 — EFCC Church Management System (TypeScript WebApp)",
  "type": "module",
  "scripts": {
    "prepare": "husky",
    "postinstall": "playwright install chromium",
    "bootstrap": "pnpm install --frozen-lockfile && pnpm --dir web install --frozen-lockfile",
    "dev:local": "pnpm --dir web dev:local",
    "db:seed:local": "node --experimental-strip-types tests/e2e/seed-local-d1.ts",
    "db:seed:disposable": "node --experimental-strip-types tests/e2e/seed-disposable-identity.ts",
    "db:seed:demo": "tsx tests/e2e/seed-demo.ts",
    "verify:contraction": "node --experimental-strip-types tests/e2e/verify-phase-f-contraction.ts",
    "verify:identity": "pnpm --dir web exec vitest run --config vitest.config.ts lib/identity/d1-schema.test.ts lib/identity/seeds.test.ts lib/identity/role-hierarchy.test.ts lib/identity/role-handlers.test.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tests/e2e/tsconfig.json",
    "test": "vitest run tests/prototype",
    "test:prototype": "vitest run tests/prototype",
    "test:workerd": "pnpm --dir web exec vitest run --config vitest.config.ts",
    "test:runtime": "vitest run scripts/run-programs-acceptance.test.ts web/scripts/run-programs-test-harness.test.mjs",
    "test:governance": "vitest run scripts/audit-governance.test.ts",
    "verify:fast": "pnpm typecheck && pnpm --dir web typecheck",
    "verify:governance": "tsx scripts/audit-governance.ts --mode=full",
    "verify:governance:fast": "tsx scripts/audit-governance.ts --mode=fast",
    "verify:governance:affected": "tsx scripts/audit-governance.ts --mode=affected",
    "verify:governance:full": "tsx scripts/audit-governance.ts --mode=full",
    "verify:governance:release": "tsx scripts/audit-governance.ts --mode=release",
    "verify:programs-runtime": "node web/scripts/run-programs-test-harness.mjs",
    "diagnose:wrangler-dev": "tsx scripts/run-programs-acceptance.ts",
    "verify:precommit": "pnpm verify:fast && pnpm test && pnpm test:governance && pnpm test:runtime && pnpm verify:identity && pnpm test:workerd && pnpm --dir web test:components && pnpm verify:governance",
    "verify": "pnpm verify:precommit && pnpm test:shell-responsive && pnpm test:shell-geometry && pnpm test:role-hierarchy-geometry",
    "test:shell-responsive": "playwright test --config=tests/e2e/responsive.config.ts",
    "test:shell-geometry": "playwright test --config=tests/e2e/shell-geometry.config.ts",
    "test:role-hierarchy-geometry": "playwright test --config=tests/e2e/role-hierarchy-geometry.config.ts",
    "build": "echo No root build step; the web app is built and served by the Worker (see web/).",
    "check": "ultracite check",
    "fix": "ultracite fix"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.1.2",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "oxfmt": "0.61.0",
    "oxlint": "1.76.0",
    "tsx": "^4.23.5",
    "typescript": "^7.0.2",
    "ultracite": "7.10.0",
    "vitest": "^2.1.9"
  },
  "lint-staged": {
    "*.{js,cjs,mjs,jsx,ts,tsx,cts,mts}": "oxfmt --write --no-error-on-unmatched-pattern",
    "*.{json,jsonc,css,scss,html,md}": "oxfmt --write --no-error-on-unmatched-pattern"
  },
  "packageManager": "pnpm@11.7.0"
}
