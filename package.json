{
  "name": "efcc",
  "version": "0.1.0",
  "private": true,
  "description": "顯恩堂系統 — EFCC Church Management System (TypeScript WebApp)",
  "type": "module",
  "scripts": {
    "prepare": "husky",
    "postinstall": "playwright install chromium",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tests/e2e/tsconfig.json",
    "test": "vitest run tests/gas tests/prototype",
    "test:gas": "vitest run tests/gas",
    "test:prototype": "vitest run tests/prototype",
    "e2e:auth": "tsx tests/e2e/auth.ts",
    "test:e2e": "playwright test --config=tests/e2e/playwright.config.ts",
    "test:shell-responsive": "playwright test --config=tests/e2e/responsive.config.ts",
    "posttest:e2e": "tsx tests/e2e/plan-doc-appender.ts",
    "build": "echo No build step; see src/gas/",
    "check": "ultracite check",
    "fix": "ultracite fix"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.0",
    "@types/node": "^26.1.2",
    "husky": "^9.1.7",
    "lint-staged": "^15.4.0",
    "oxfmt": "0.61.0",
    "oxlint": "1.76.0",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "ultracite": "7.9.4",
    "vitest": "^2.1.9"
  },
  "lint-staged": {
    "*.{js,cjs,mjs,jsx,ts,tsx,cts,mts}": "ultracite fix",
    "*.{json,jsonc,css,scss,html,md}": "oxfmt --write --no-error-on-unmatched-pattern"
  },
  "packageManager": "pnpm@11.7.0"
}
