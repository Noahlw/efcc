{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "lib": ["ES2022", "DOM"],
    "types": ["@cloudflare/workers-types", "vite/client"],
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true
