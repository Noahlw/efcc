{
  "$schema": "https://unpkg.com/knip@6.38.0/schema.json",
  // Configuration hints are errors: an unresolved hint fails the gate
  // instead of silently weakening the analysis (knip.dev/reference/configuration-hints).
  "treatConfigHintsAsErrors": true,
  "workspaces": {
    ".": {
      // Playwright configs are entries via --config= CLI flags, which the
      // script parser cannot see; serve-static and plan-doc-appender are
      // manual CLI tools documented in tests/e2e/README.md.
      "entry": [
        "scripts/*.{mjs,ts}",
        "tests/e2e/seed-*.{ts,mts}",
        "tests/e2e/*.config.ts",
        "tests/e2e/serve-static.ts",
        "tests/e2e/plan-doc-appender.ts",
        "tests/e2e/inspect-local-identity-schema.ts",
      ],
      "project": ["scripts/**/*.{ts,mjs}", "tests/e2e/**/*.{ts,mts,mjs}"],
    },
    "web": {
      // Next.js/Vitest/Playwright/Storybook/Tailwind/Wrangler/MSW entries
      // are automatic. `!` marks shipped production code (static export +
      // edge Worker). Empirical Knip behavior (v6.38.0, recorded in the
      // #650 ledger): plugin-claimed files (app/**, worker.ts) do not
      // carry production status, so --production is an advisory signal
      // over explicitly marked entries; default mode is the enforcement
      // gate for new unused-code debt.
      "entry": [
        "scripts/*.mjs",
        "app/**/page.tsx!",
        "app/**/layout.tsx!",
        "app/**/not-found.tsx!",
      ],
      "project": [
        "app/**/*.{ts,tsx}!",
        "app/**/*.css!",
        "lib/**/*.{ts,tsx}!",
        "components/**/*.{ts,tsx}!",
        "**/*.{ts,tsx,mjs,css}",
      ],
      "ignore": [
        // web/.storybook/public/mockServiceWorker.js is generated by `msw init`
        // (.js, outside the ts/tsx/mjs/css project globs); never hand-edit.
        // Storybook build output is generated and must not enter source triage.
        "storybook-static/**",
      ],
      "ignoreDependencies": [
        // Runtime-provided workerd builtins (`cloudflare:workers`,
        // `cloudflare:test`); no npm package exists. Knip parses the
        // specifier as package `cloudflare`.
        "cloudflare",
      ],
    },
  },
}
