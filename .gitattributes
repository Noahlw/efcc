# Auto-detect text files and normalize to LF
* text=auto

# Source always LF
*.gs    text eol=lf
*.html  text eol=lf
*.js    text eol=lf
*.ts    text eol=lf
*.json  text eol=lf
*.md    text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.css   text eol=lf
*.sh    text eol=lf

# Binary — never normalize
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.zip   binary
*.xlsx  binary
*.pdf   binary
*.db    binary
*.sqlite binary
