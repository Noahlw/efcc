# Dependencies (pnpm)
node_modules/
package-lock.json
# Build output
dist/
build/

# OS / editor auto-generated junk
.DS_Store
Thumbs.db
*.swp
*.swo
.idea/

# AI coding tooling local state (per-project config/caches, not repo content)
.codex/
.cursor/
.claude/
.opencode/
.serena/
.impeccable/config.local.json

# Local scratch notes (never commit)
local/

# Test / coverage output
coverage/
.nyc_output/
test-results/

# Storybook build output
apps/web/storybook-static/

# Logs
*.log
npm-debug.log*

# E2E auth (Playwright storage state — session cookies, never commit)
.auth/*
.env
!.auth/.example/
!.auth/.example/**

# Local OAuth client credentials must never enter Git.
client_secret*.json
docs/client_secret*.json

# Isolated worktrees for stacked-PR implementation
.worktrees/
